# =============================================================================
# ltw-camera-server:0.2-dds
#
# Unitree G1 head(ego-view) 카메라 프레임을 D435i USB 직접 접근이 아니라,
# PC2(Orin NX)의 videohub_pc4 시스템 서비스가 이미 CycloneDDS로 publish 중인
# 프레임을 subscribe해서 그대로 ZMQ port 5555로 forward하는 방식.
#
# Target: Unitree G1 Orin NX (PC2, eth0 192.168.123.164/24, aarch64)
#
# 이미지명:   ltw-camera-server:0.2-dds
# 컨테이너명: ltw-camera-server-dds
# =============================================================================
#
# [배경] docker/Dockerfile.ltw_camera_server (0.1-rgb, pyrealsense2 직접 USB
# 접근 방식)는 D435i가 PC1(Unitree 내부, 접근 불가)에 물리 연결되어 있고
# PC2의 /dev/video4는 videohub_pc4(root, master_service.service 하위)가
# 상시 점유(EBUSY) 중이라 동작 불가능함이 확인됨. 이 파일은 그 대안으로,
# videohub_pc4가 이미 발행 중인 DDS topic(rt/frontvideostream)을
# subscribe하는 방식. USB/디바이스 접근 전혀 없음.
#
# [Build] (Orin NX에서, GR00T-WholeBodyControl/ 루트에서)
#   docker build -f docker/Dockerfile.ltw_camera_server_dds \
#                -t ltw-camera-server:0.2-dds .
#
# [Run — USB/디바이스 마운트 불필요, --network host만 필요 (DDS discovery)]
#   docker run --rm \
#     --name ltw-camera-server-dds \
#     --network host \
#     ltw-camera-server:0.2-dds
#
# [Run - 소스 override, 개발용]
#   docker run --rm \
#     --name ltw-camera-server-dds \
#     --network host \
#     -v $(pwd)/gear_sonic:/app/gear_sonic:ro \
#     ltw-camera-server:0.2-dds
#
# [Rollback]
#   docker rm -f ltw-camera-server-dds 2>/dev/null; docker rmi ltw-camera-server:0.2-dds
# =============================================================================

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8

SHELL ["/bin/bash", "-c"]

# -----------------------------------------------------------------------------
# 1. Base tools + Python 3.10
# -----------------------------------------------------------------------------
# Ubuntu 22.04 ships Python 3.10 as default. build-essential + cmake needed
# for CycloneDDS + Python cyclonedds source build (no aarch64 wheel).
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 \
        python3-dev \
        python3-pip \
        build-essential \
        cmake \
        pkg-config \
        git \
        ca-certificates \
        locales \
    && locale-gen en_US.UTF-8 \
    && rm -rf /var/lib/apt/lists/*

# -----------------------------------------------------------------------------
# 2. CycloneDDS C library from source (0.10.2 — NOT the latest release)
# -----------------------------------------------------------------------------
# Version pinned to 0.10.2, matching unitree_sdk2py's own
# install_requires ("cyclonedds==0.10.2") and the wire protocol baked into
# the robot's prebuilt libddsc.so (gear_sonic_deploy/thirdparty/unitree_sdk2).
# A newer cyclonedds (e.g. 0.10.5) changes the wire protocol — confirmed on
# this project to break cross-process DDS communication silently (no crash,
# just no discovery) with anything still on 0.10.2, which videohub_pc4 is
# presumed to be part of, since the entire Unitree SDK stack is pinned there.
# No aarch64 wheel exists on PyPI, so both the C library and the Python
# binding are built from source.
RUN git clone --depth 1 -b 0.10.2 https://github.com/eclipse-cyclonedds/cyclonedds.git /tmp/cyclonedds \
    && cmake -S /tmp/cyclonedds -B /tmp/cyclonedds/build \
        -DCMAKE_INSTALL_PREFIX=/opt/cyclonedds/install \
        -DBUILD_EXAMPLES=OFF \
        -DBUILD_TESTING=OFF \
    && cmake --build /tmp/cyclonedds/build --target install -- -j"$(nproc)" \
    && rm -rf /tmp/cyclonedds

ENV CYCLONEDDS_HOME=/opt/cyclonedds/install
ENV LD_LIBRARY_PATH=/opt/cyclonedds/install/lib
ENV PATH=/opt/cyclonedds/install/bin:${PATH}

# -----------------------------------------------------------------------------
# 3. Python runtime dependencies
# -----------------------------------------------------------------------------
# numpy pinned: known-good aarch64 wheel compatibility with opencv-python-headless.
# opencv-python-headless: server mode, no GUI stack (no X11/libgl needed here
# since this driver never decodes/re-encodes frames — pass-through only).
RUN python3 -m pip install --no-cache-dir \
    "numpy==1.26.4" \
    "pyzmq" \
    "msgpack" \
    "msgpack-numpy" \
    "opencv-python-headless" \
    "tyro"

# -----------------------------------------------------------------------------
# 4. Python cyclonedds + unitree_sdk2py
# -----------------------------------------------------------------------------
# --no-binary forces a source build that links against the C library built
# in step 2 (via CYCLONEDDS_HOME, already set in the environment above) —
# the PyPI wheel would instead pull in an unrelated/incompatible libddsc.
RUN python3 -m pip install --no-cache-dir --no-binary cyclonedds "cyclonedds==0.10.2"

# --no-deps: unitree_sdk2py's own install_requires also lists
# cyclonedds==0.10.2, which would otherwise trigger pip to reinstall it
# from the (wrong) prebuilt wheel and undo step above.
RUN python3 -m pip install --no-cache-dir --no-deps \
    git+https://github.com/unitreerobotics/unitree_sdk2_python.git

# -----------------------------------------------------------------------------
# 5. gear_sonic camera module (only the module, not the full repo)
# -----------------------------------------------------------------------------
WORKDIR /app
COPY gear_sonic/__init__.py gear_sonic/__init__.py
COPY gear_sonic/camera/    gear_sonic/camera/

ENV PYTHONPATH=/app
ENV CAMERA_PORT=5555
ENV DDS_NETWORK_INTERFACE=eth0

EXPOSE 5555

# -----------------------------------------------------------------------------
# 6. Runtime notes
# -----------------------------------------------------------------------------
# - No USB device passthrough required (no --device, no /dev/bus/usb) — this
#   image never opens a camera device, unlike Dockerfile.ltw_camera_server.
# - --network host is required, not for the ZMQ port alone but because
#   CycloneDDS discovery (multicast/UDP) needs to see the host's real
#   network interface (eth0) to find videohub_pc4's participant.
# - Downstream (workstation run_data_exporter.py) receives raw JPEG bytes
#   (video720p) exactly as videohub_pc4 published them — no re-encoding
#   happens anywhere in this container.
# - Camera ownership: PC1 physically owns the D435i and encodes JPEG; PC2's
#   videohub_pc4 relays those frames over DDS. This container only
#   subscribes — it must never attempt to stop/restart videohub_pc4 or open
#   /dev/video4, which would break other users' access to the same feed.
CMD ["sh", "-c", "python3 -m gear_sonic.camera.composed_camera --ego-view-camera unitree_dds --port ${CAMERA_PORT} --dds-interface ${DDS_NETWORK_INTERFACE}"]
