# =============================================================================
# ltw-camera-server:0.9-foxy-3cam
#
# v5(0.8-foxy-videoclient)를 그대로 base로 얹어(FROM), 검증된 머리 카메라
# 스택(소스빌드 CycloneDDS 0.10.2 + unitree_sdk2py + numpy/opencv 핀)은
# 전혀 건드리지 않고, 손목 D405 2대를 읽기 위한 RealSense 레이어만 추가한다.
#
# 즉 이 v6는 "v5 + librealsense2 + pyrealsense2 + 3-cam forwarder" 이다.
# v5 이미지가 로컬에 있어야 빌드된다(현재 로봇에서 구동 중이므로 존재).
#
# 결과: 머리(ego_view, VideoClient RPC) + 좌우 손목(D405, pyrealsense2)을
#       하나의 ZMQ 5555 페이로드로 합쳐 forward. workstation의
#       run_data_exporter.py --record-wrist-cameras 와 짝을 이룬다.
#
# Target: Unitree G1 Orin NX (PC2, eth0 192.168.123.164/24, aarch64,
#         JetPack R35.3.1 / Ubuntu 20.04 focal, Python 3.8)
#
# [Build] (Orin NX에서, docker/ 를 build context로)
#   docker build -f docker/Dockerfile.ltw_camera_server_ros2foxy_v6 \
#                -t ltw-camera-server:0.9-foxy-3cam docker/
#
# [Run]
#   ./docker/run_ltw_camera_server_ros2foxy_v6.sh
#   (D405 USB 패스스루가 필요하므로 v5 run 스크립트와 다르다 — 전용 스크립트 사용)
#
# [Rollback]
#   머리만 필요하면 언제든 v5로 복귀: ./docker/run_ltw_camera_server_ros2foxy.sh
#   docker rmi ltw-camera-server:0.9-foxy-3cam   # v5 이미지는 그대로 남음
# =============================================================================

FROM ltw-camera-server:0.8-foxy-videoclient

ENV DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-c"]

# -----------------------------------------------------------------------------
# 1. USB 런타임 (libusb) — pyrealsense2 wheel이 dlopen 할 수 있음
# -----------------------------------------------------------------------------
# librealsense apt 저장소는 쓰지 않는다. 이유: Intel repo의 InRelease를 서명한
# 키(FB0B24895113F120)가 배포 중인 librealsense.pgp 에 포함돼 있지 않아
# apt-get update가 GPG 검증 실패(NO_PUBKEY)로 죽는다. 그리고 애초에 불필요하다 —
# pip pyrealsense2 wheel은 librealsense 런타임을 자체 번들하고, 장치 열거는
# forwarder --list-devices(pyrealsense2)로 된다.
# libusb-1.0-0 만 우분투 main(별도 키 불필요)에서 미리 깔아 둔다 — wheel이
# USB 접근에 이 .so 를 필요로 할 수 있기 때문.
RUN apt-get update && apt-get install -y --no-install-recommends \
        libusb-1.0-0 \
    && rm -rf /var/lib/apt/lists/*

# -----------------------------------------------------------------------------
# 2. pyrealsense2 (Python 바인딩, pip wheel — librealsense 자체 번들)
# -----------------------------------------------------------------------------
# --no-deps: v5에서 핀 고정한 numpy==1.24.4 / opencv-python-headless==4.8.1.78 를
#            pyrealsense2가 다른 버전으로 끌어올리지 못하게 막는다(머리 스택
#            보호). pyrealsense2는 numpy를 런타임에 느슨하게만 쓰므로 문제없다.
#
# [빌드 시 검증 필요 — 이 프로젝트 유일한 불확실점]
#   aarch64 + Python 3.8(cp38) 조합의 pyrealsense2 prebuilt wheel이 PyPI에
#   있는지가 관건이다. 있으면 이 RUN 한 줄로 끝난다.
#   "Could not find a version that satisfies the requirement pyrealsense2" 로
#   실패하면 cp38/aarch64 wheel이 없는 것 → librealsense를 소스에서
#   -DBUILD_PYTHON_BINDINGS=ON 으로 빌드하는 블록으로 교체해야 한다(~30~60분).
# 검증: pyrealsense2는 __version__ 속성이 없으므로, 바인딩이 로드되고 핵심
# 심볼(pipeline)이 있는지로 확인한다.
RUN python3 -m pip install --no-cache-dir --no-deps "pyrealsense2" \
    && python3 -c "import pyrealsense2 as rs; assert hasattr(rs, 'pipeline'); print('[v6] pyrealsense2 import OK')"

# -----------------------------------------------------------------------------
# 3. 3-cam forwarder 앱
# -----------------------------------------------------------------------------
WORKDIR /app
COPY src/camera_forwarder_3cam.py /app/camera_forwarder_3cam.py

# -----------------------------------------------------------------------------
# 4. Runtime notes / CMD
# -----------------------------------------------------------------------------
# - v5와 달리 이 컨테이너는 D405 USB 장치를 직접 연다. run 스크립트에서
#   USB 패스스루(-v /dev:/dev + device-cgroup-rule)를 반드시 넘겨야 한다.
#   (전용 run_ltw_camera_server_ros2foxy_v6.sh 참조)
# - --network host 는 여전히 필요(VideoClient CycloneDDS discovery + ZMQ 5555).
# - 이 컨테이너는 videohub_pc4/호스트 서비스를 절대 정지·재시작하지 않는다.
#   D405는 우리 카메라이고 우리 시리얼만 open 하므로 다른 팀 피드에 영향 없음.
# - CYCLONEDDS_URI / ROS_DOMAIN_ID / LD_LIBRARY_PATH 등은 v5 이미지 ENV를
#   그대로 상속하므로 여기서 재설정 불필요.
EXPOSE 5555

# 손목 좌우가 바뀌면 --left-serial/--right-serial 로 고정할 것(run 스크립트에서
# 환경변수로 넘기도록 해둠). 미지정 시 시리얼 정렬 자동배정 + 매핑 로그 출력.
CMD ["python3", "/app/camera_forwarder_3cam.py", "--port", "5555", \
     "--head-mount", "ego_view", "--wrist-fps", "30", \
     "--wrist-width", "640", "--wrist-height", "480"]
