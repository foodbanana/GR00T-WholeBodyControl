# =============================================================================
# ltw-camera-server:1.1-foxy-3cam   (v8)
#
# 머리(ego_view) + 좌우 손목(D405)을 하나의 ZMQ 5555 페이로드로 합쳐 발행한다.
# workstation 의 run_data_exporter.py --record-wrist-cameras 와 짝을 이룬다.
#
# [v7(1.0-foxy-3cam) 과의 차이 — 2개]
#   1. 섹션 5.5: pip wheel(pyrealsense2) -> librealsense 소스빌드(RSUSB 백엔드).
#      pip wheel 은 V4L2 백엔드라 L4T 순정 uvcvideo 의 XU 컨트롤 한계에 걸려
#      프레임이 0개였다. 상세는 섹션 5.5 참조.
#   2. CMD 에 --head-backend realsense 명시.
#   섹션 1~5 는 v7 과 바이트 동일하므로 CycloneDDS 소스빌드(30~60분)를 포함한
#   앞 레이어는 전부 캐시 히트하고 5.5 부터만 다시 돈다.
#
# [머리 백엔드 2종]
#   --head-backend realsense  : librealsense 직결 (640x480@30 직접 요청, 기본)
#   --head-backend videohub   : VideoClient RPC (v7 과 동일, 1080p)
#
# ★ 이미지 태그는 v7 과 반드시 달라야 한다(1.0 vs 1.1). 같으면 v8 빌드가 v7
#   이미지를 덮어써서 롤백 자산이 사라진다.
# ※ forwarder(camera_forwarder_3cam.py)는 v7 과 같은 파일을 쓴다(복제 금지).
#   --head-backend 기본값이 videohub 라 같은 파일로 v7 동작이 재현된다.
#
# Target: Unitree G1 Orin NX (eth0 192.168.123.164/24, aarch64,
#         JetPack R35.3.1 / Ubuntu 20.04 focal, Python 3.8)
#
# [새 로봇에서 빌드하기 전 실측할 것] — 버전 핀이 전부 구 G1 Orin NX 기준이다
#   1) videohub CycloneDDS 버전 (섹션 3.5 의 0.10.2)
#        sudo ldd /proc/$(pgrep videohub_pc4)/exe | grep dds
#      ※ realsense 백엔드만 쓴다면 DDS 를 안 거치므로 이 핀은 무의미하다.
#   2) JetPack/L4T 버전 (r35.3.1 = Python 3.8 전제 — 섹션 4.7/5/5.5 핀의 근거)
#        cat /etc/nv_tegra_release
#   3) D405 color 노드 by-id 경로 (-video-indexN 은 커널 열거 순서로 바뀐다)
#        ls /dev/v4l/by-id/
#
# [Build] docker/ 를 build context 로 줘야 한다 (COPY 가 상대경로)
#   docker build -f docker/Dockerfile.ltw_camera_server_ros2foxy_v8 \
#                -t ltw-camera-server:1.1-foxy-3cam docker/
#
# [Run]
#   ./docker/run_ltw_camera_server_ros2foxy_v8.sh          # 머리=realsense(기본)
#   HEAD_BACKEND=videohub ./docker/run_..._v8.sh           # 머리=RPC(v7과 동일)
#
# [Rollback] v7 이미지가 남아 있으면 즉시 복귀 가능
#   docker rm -f ltw-camera-server 2>/dev/null
#   ./docker/run_ltw_camera_server_ros2foxy_v7.sh
# =============================================================================

# l4t-jetpack r35.3.1 = JetPack 5.1.1 = Ubuntu 20.04(focal) — 호스트 OS/Foxy 와
# 일치. 이 컨테이너 자체는 GPU 를 쓰지 않지만 향후 확장 여지로 유지한다.
FROM nvcr.io/nvidia/l4t-jetpack:r35.3.1

ENV DEBIAN_FRONTEND=noninteractive
ENV ROS_DISTRO=foxy
ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8
SHELL ["/bin/bash", "-c"]

# -----------------------------------------------------------------------------
# 1. Base tools + locale
# -----------------------------------------------------------------------------
# build-essential/cmake: 섹션 3.5 CycloneDDS 소스빌드용.
# python3-dev/libpython3-dev: 섹션 4.5 cyclonedds 소스빌드 시 Python.h 필요.
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        curl \
        git \
        gnupg \
        libpython3-dev \
        locales \
        lsb-release \
        python3-dev \
        python3-pip \
    && locale-gen en_US.UTF-8 \
    && update-locale LANG=en_US.UTF-8 \
    && rm -rf /var/lib/apt/lists/*

# -----------------------------------------------------------------------------
# 2. ROS 2 Foxy apt source
# -----------------------------------------------------------------------------
RUN curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
        -o /usr/share/keyrings/ros-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu $(lsb_release -cs) main" \
        > /etc/apt/sources.list.d/ros2.list

# -----------------------------------------------------------------------------
# 3. ROS 2 Foxy + rmw-cyclonedds (apt)
# -----------------------------------------------------------------------------
# 이 스택은 rclpy/rmw 를 실제로 거치지 않는다(VideoClient RPC 가 Python
# cyclonedds binding 으로 libddsc 를 직접 호출). 그래도 Foxy 를 유지하는 것은
# 향후 센서 통합 여지와 rosidl-generator-dds-idl 때문이다.
# 여기서 딸려오는 apt CycloneDDS 0.7.x 는 지우지 않는다 — 섹션 3.6 의
# LD_LIBRARY_PATH 순서로 우리 0.10.2 가 먼저 로드된다.
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3-catkin-pkg \
        python3-empy \
        python3-lark \
        ros-foxy-ros-base \
        ros-foxy-rmw-cyclonedds-cpp \
        ros-foxy-rosidl-generator-dds-idl \
        python3-colcon-common-extensions \
    && rm -rf /var/lib/apt/lists/*

# -----------------------------------------------------------------------------
# 3.5. CycloneDDS 0.10.2 (source build)
# -----------------------------------------------------------------------------
# 호스트 videohub_pc4 가 0.10.2 를 쓰는데 apt 의 ros-foxy-cyclonedds 는 0.7.0
# 이라 DDSI-RTPS wire protocol 이 mismatch 였다(segfault / discovery 후 data
# zero 등으로 발현). 버전이 어긋나면 크래시 없이 조용히 discovery 만 실패해
# 진단이 어렵다. 이 버전은 unitree_sdk2py 가 요구하는 Python binding
# cyclonedds==0.10.2 의 C library 백엔드도 겸한다(섹션 4.5).
ARG CYCLONEDDS_VERSION=0.10.2

WORKDIR /opt
RUN git clone --depth 1 --branch ${CYCLONEDDS_VERSION} \
    https://github.com/eclipse-cyclonedds/cyclonedds.git

WORKDIR /opt/cyclonedds/build
RUN cmake .. \
        -DBUILD_EXAMPLES=OFF \
        -DBUILD_IDLC=ON \
        -DCMAKE_INSTALL_PREFIX=/opt/cyclonedds/install \
    && cmake --build . --target install \
    && rm -rf /opt/cyclonedds/build

# ENABLE_SHM 은 기본값을 쓴다. SHM 문제가 생기면 -DENABLE_SHM=OFF 검토.

# -----------------------------------------------------------------------------
# 3.6. CycloneDDS ENV (LD_LIBRARY_PATH override)
# -----------------------------------------------------------------------------
# 순서가 결정적이다 — 우리 0.10.2(/opt/cyclonedds/install/lib)가 apt 0.7.0
# (/opt/ros/foxy/lib)보다 **앞**에 있어야 한다.
ENV CYCLONEDDS_HOME=/opt/cyclonedds/install
ENV CycloneDDS_DIR=/opt/cyclonedds/install/lib/cmake/CycloneDDS
ENV CMAKE_PREFIX_PATH=/opt/cyclonedds/install:/opt/ros/foxy
ENV LD_LIBRARY_PATH=/opt/cyclonedds/install/lib:/opt/ros/foxy/lib:/opt/ros/foxy/lib/aarch64-linux-gnu
ENV PATH=/opt/cyclonedds/install/bin:${PATH}

# -----------------------------------------------------------------------------
# 4. Python packaging preparation
# -----------------------------------------------------------------------------
# setuptools 는 59.6.0 고정 — 최신은 ament_python 등과 충돌 가능.
RUN python3 -m pip install --upgrade pip wheel \
    && python3 -m pip install --force-reinstall "setuptools==59.6.0"

# -----------------------------------------------------------------------------
# 4.5. Python CycloneDDS binding (source build, 0.10.2)
# -----------------------------------------------------------------------------
# unitree_sdk2_python 이 정확히 cyclonedds==0.10.2 를 요구한다.
# --no-binary: prebuilt wheel 은 자체 CycloneDDS 를 번들해 섹션 3.5 소스빌드본과
#   충돌할 수 있다. 소스빌드하면 CYCLONEDDS_HOME 을 참조해 우리 것으로 링크된다.
RUN python3 -m pip install --no-cache-dir \
    --no-binary cyclonedds \
    "cyclonedds==0.10.2"

# -----------------------------------------------------------------------------
# 4.6. unitree_sdk2_python — videohub 백엔드용
# -----------------------------------------------------------------------------
# VideoClient 로 /api/videohub/request RPC 를 보내면 JPEG 응답이 온다
# (Go2 SDK 지만 G1 도 같은 endpoint 를 노출한다).
# --no-deps: 소스빌드한 cyclonedds 가 pip 에 의해 교체되는 것을 막는다.
# 커밋 SHA pin: --no-deps 라 pip 이 요구사항을 검증하지 않으므로, upstream 이
#   cyclonedds 버전 요구를 바꿔도 조용히 깨지지 않도록 시점을 못 박는다.
ARG UNITREE_SDK2PY_COMMIT=37116c521f1588482e238d8450e471ba78ab9863

WORKDIR /opt
RUN git clone https://github.com/unitreerobotics/unitree_sdk2_python.git \
    && cd unitree_sdk2_python \
    && git checkout ${UNITREE_SDK2PY_COMMIT} \
    && python3 -m pip install --no-deps .

# -----------------------------------------------------------------------------
# 4.7. numpy, opencv
# -----------------------------------------------------------------------------
# --no-deps 로 unitree_sdk2py 를 깔았으므로 여기서 별도 설치.
# opencv 는 손목 V4L2 캡처의 주역이다(cv2.VideoCapture).
# 버전 pin: aarch64 + Python 3.8 조합에서 prebuilt wheel 이 존재하는 마지막
# stable. ★ Python 이 3.8 이 아니면 이 핀은 전부 무효다.
RUN python3 -m pip install --no-cache-dir \
    "numpy==1.24.4" \
    "opencv-python-headless==4.8.1.78"

# -----------------------------------------------------------------------------
# 5. Python 런타임 의존성 (ZMQ 발행)
# -----------------------------------------------------------------------------
# 마찬가지로 aarch64 + Python 3.8 prebuilt wheel 이 있는 버전.
RUN python3 -m pip install --no-cache-dir \
        "pyzmq==25.1.2" \
        "msgpack==1.0.5"

# -----------------------------------------------------------------------------
# 5.5. librealsense 소스빌드 (RSUSB 백엔드) — v8 의 존재 이유
# -----------------------------------------------------------------------------
# 왜 pip wheel 이 아니라 소스빌드인가:
#   pip install pyrealsense2 로는 장치 열거 / 프로파일 노출 / pipeline.start()
#   까지 되지만 wait_for_frames 에서 0프레임이었고, 커널이 이렇게 찍었다:
#     uvcvideo: Failed to query (GET_CUR) UVC control 1 on unit 3: -32
#   -32 = EPIPE = 컨트롤 엔드포인트 STALL, unit 3 = UVC 의 XU(extension unit).
#   librealsense 는 XU 로 센서를 설정하는데 순정 uvcvideo 가 이 확장 컨트롤을
#   통과시키지 못한다(librealsense #5302 와 동일). 표준 UVC 인 S_FMT 까지만
#   되고 스트리밍이 안 되는 이유다. USB 논리 replug 로도 동일 — 장치 wedge 가
#   아니라 커널 드라이버의 구조적 한계다.
#
#   공식 해법은 둘인데 (a) 커널 uvcvideo 패치는 공유 로봇의 커널 모듈을 바꾸고
#   재부팅해야 하므로 채택하지 않았다. (b) -DFORCE_RSUSB_BACKEND=true 소스빌드는
#   V4L2/uvcvideo 를 통째로 우회하고 libusb 로 USB 를 직접 다뤄 컨테이너 안에서
#   완결된다.
#
#   ※ RSUSB 는 multi-cam 에 최적화돼 있지 않다(Intel 문서).
#   ※ 빌드는 Orin NX 에서 20~40분. 대신 앞 레이어는 v7 캐시를 그대로 쓴다.
ARG LIBREALSENSE_VERSION=v2.55.1

# libusb-1.0-0-dev 가 RSUSB 백엔드의 핵심(런타임 libusb-1.0-0 포함).
# libudev-dev 는 장치 열거에 쓰인다.
RUN apt-get update && apt-get install -y --no-install-recommends \
        libssl-dev \
        libusb-1.0-0-dev \
        libudev-dev \
        pkg-config \
    && rm -rf /var/lib/apt/lists/*

# pip wheel 이 남아 있으면 소스빌드본을 가린다.
RUN python3 -m pip uninstall -y pyrealsense2 2>/dev/null || true

WORKDIR /opt
RUN git clone --depth 1 --branch ${LIBREALSENSE_VERSION} \
    https://github.com/IntelRealSense/librealsense.git

# 빌드를 3개 RUN 으로 나누고 빌드 트리(/opt/librealsense/build)를 **지우지
# 않는다.** 이미지가 1~2GB 커지지만, 산출물과 CMakeCache 가 남아 있어야
# "본체 모듈이 왜 안 나왔는가" 같은 문제를 컨테이너에 들어가 바로 확인할 수
# 있다. 파이프라인이 안정되면 그때 지운다.
WORKDIR /opt/librealsense/build
RUN set -eo pipefail \
    && cmake .. \
        -DCMAKE_BUILD_TYPE=Release \
        -DFORCE_RSUSB_BACKEND=true \
        -DBUILD_PYTHON_BINDINGS=true \
        -DPYTHON_EXECUTABLE=/usr/bin/python3 \
        -DPython_EXECUTABLE=/usr/bin/python3 \
        -DPython3_EXECUTABLE=/usr/bin/python3 \
        -DPython_ROOT_DIR=/usr \
        -DPython3_ROOT_DIR=/usr \
        -DBUILD_EXAMPLES=false \
        -DBUILD_GRAPHICAL_EXAMPLES=false \
        -DBUILD_WITH_CUDA=false \
        -DCMAKE_INSTALL_PREFIX=/usr/local \
        2>&1 | tee /opt/librealsense/cmake_configure.log \
    && echo "=== [v8] cmake가 고른 Python / 바인딩 설정 ===" \
    && grep -iE "python|pybind|binding" /opt/librealsense/cmake_configure.log || true

# 컴파일. Orin NX 에서 20~40분.
# 메모리 부족(c++: fatal error: Killed)이 나면 -j"$(nproc)" 를 -j4 로 낮출 것.
RUN make -j"$(nproc)"

# install 전에 빌드 트리 산출물을 찍어 둔다 — 본체 모듈이 안 보일 때
# "안 만들어진 것"인지 "install 이 빠뜨린 것"인지 구분하기 위해서다.
# (BUILD_PYTHON_BINDINGS=ON 이면 pyrsutils 가 함께 빌드되므로, pyrsutils 의
#  존재 자체가 바인딩이 켜져 있었다는 증거다.)
RUN echo "=== [v8] 빌드 트리에 생성된 Python 모듈 ===" \
    && (find /opt/librealsense/build \( -name "py*.so*" -o -name "*.pyd" \) \
            -printf "%10s  %p\n" | sort -k2 || true) \
    && echo "=== [v8] wrappers/python 빌드 산출물 트리 ===" \
    && (ls -laR /opt/librealsense/build/wrappers/python 2>/dev/null | head -60 || true)

RUN make install && ldconfig

# -----------------------------------------------------------------------------
# 5.6. pyrealsense2 배치 + 검증
# -----------------------------------------------------------------------------
# 이 단계가 필요한 이유: librealsense 2.55 의 `make install` 은 본체 모듈을
# 설치하지 않는다. pyrsutils 와 cmake 파일만 dist-packages 에 깔고 본체
# (pyrealsense2.cpython-*.so)는 빌드 트리(build/Release/)에만 남긴다.
#
# 함정 3가지 — 아래 RUN 은 이것들을 전제로 짜여 있다:
#   (1) 빈 디렉터리가 만드는 가짜 성공
#       pip uninstall 은 파일만 지우고 빈 dist-packages/pyrealsense2/ 를 남기는데,
#       파이썬이 그것을 namespace package 로 잡아 `import pyrealsense2` 가
#       **성공한다**(rs.__file__ is None, pipeline 심볼 없음). 그래서 검증은
#       import 성공이 아니라 rs.__file__ 이 실제 .so 인지로 판정한다.
#   (2) 설치 경로를 박으면 안 된다
#       librealsense 는 sysconfig 가 알려주는 경로에 깐다(버전/플랫폼마다 다름).
#       그래서 find 로 찾고, install 이 빠뜨렸을 경우를 대비해 빌드 트리도 뒤진다.
#   (3) 파일명이 .so 로 끝나야 한다
#       실체 파일은 pyrealsense2.cpython-38-aarch64-linux-gnu.so.2.55.1 이고
#       .so / .so.2.55 는 심볼릭 링크다. `find -type f` 는 실체만 잡는데 그
#       이름은 .so 로 끝나지 않아 파이썬 확장모듈 로더가 인식하지 못한다.
#       복사할 때 버전 접미사를 떼어낸다.
#
# 배치 전략: 본체 .so 를 PYTHONPATH 최상위에 **모듈 파일 그대로** 둔다(패키지
#   디렉터리 안에 넣으면 (1)의 namespace package 가 먼저 잡혀 또 가려진다).
ENV PYTHONPATH=/usr/local/lib/python3.8/dist-packages
ENV LD_LIBRARY_PATH=/usr/local/lib:/opt/cyclonedds/install/lib:/opt/ros/foxy/lib:/opt/ros/foxy/lib/aarch64-linux-gnu

RUN set -x \
    && echo "=== [v8] 설치된 librealsense python 산출물 ===" \
    && (find /usr/local /usr/lib \( -name "*pyrealsense2*" -o -name "*pyrsutils*" \
            -o -name "*pybackend2*" \) 2>/dev/null || true) \
    && mkdir -p /usr/local/lib/python3.8/dist-packages \
    && echo "=== [v8] 본체 모듈 탐색 (설치 위치 + 빌드 트리) ===" \
    && RS_SO="$(find /usr/local/lib /usr/lib /opt/librealsense/build \
                     -name 'pyrealsense2*.so*' -type f 2>/dev/null | head -1)" \
    && echo "찾은 본체 모듈: '${RS_SO:-<없음>}'" \
    && if [ -z "$RS_SO" ]; then \
           echo "!!! [v8] pyrealsense2 본체 .so 를 찾지 못했다."; \
           echo "!!! 위 '빌드 트리에 생성된 Python 모듈' 출력을 확인할 것."; \
           echo "!!! pyrsutils 만 있고 본체가 없다면 타깃이 all 에 포함되지"; \
           echo "!!! 않았다는 뜻 -> make pyrealsense2 를 명시 호출해야 한다."; \
           exit 1; \
       fi \
    && RS_NAME="$(basename "$RS_SO" | sed 's/\.so\..*$/.so/')" \
    && echo "설치 파일명: $RS_NAME  (버전 접미사 제거)" \
    && cp -v "$RS_SO" "/usr/local/lib/python3.8/dist-packages/$RS_NAME" \
    && (RSU_SO="$(find /usr/local/lib /usr/lib /opt/librealsense/build \
                       -name 'pyrsutils*.so*' -type f 2>/dev/null | head -1)"; \
        if [ -n "$RSU_SO" ]; then \
            RSU_NAME="$(basename "$RSU_SO" | sed 's/\.so\..*$/.so/')"; \
            cp -v "$RSU_SO" "/usr/local/lib/python3.8/dist-packages/$RSU_NAME"; \
        fi) \
    && echo "=== [v8] dist-packages 최종 내용 ===" \
    && ls -la /usr/local/lib/python3.8/dist-packages/ \
    && echo "=== [v8] import 검증 (namespace package 가 아닌 진짜 모듈인지) ===" \
    && python3 -c "\
import pyrealsense2 as rs; \
print('[v8] rs.__file__ =', rs.__file__); \
assert rs.__file__, 'namespace package를 집었다 — 진짜 .so가 로드되지 않았다'; \
assert hasattr(rs, 'pipeline'), 'pipeline 심볼 없음'; \
print('[v8] pyrealsense2 (source build) OK, 심볼 수 =', len(dir(rs)))" \
    && echo "=== [v8] RSUSB 백엔드 확인 ===" \
    && ldd /usr/local/lib/librealsense2.so | grep -q libusb \
    && echo "[v8] librealsense2.so -> libusb 링크 확인 = RSUSB 백엔드 OK"

# -----------------------------------------------------------------------------
# 6. Runtime env
# -----------------------------------------------------------------------------
# RMW_IMPLEMENTATION 은 설정하지 않는다 — VideoClient 는 rclpy/rmw 를 거치지
#   않고 Python cyclonedds binding 이 libddsc 를 직접 호출한다.
# ROS_DOMAIN_ID: videohub_pc4 와 같은 domain(0)이어야 RPC discovery 가 된다.
# CYCLONEDDS_URI: Python cyclonedds binding 이 이 config 로 eth0 을 쓴다.
ENV ROS_DOMAIN_ID=0
ENV CYCLONEDDS_URI=file:///etc/cyclonedds.xml

# -----------------------------------------------------------------------------
# 7. App
# -----------------------------------------------------------------------------
# ※ forwarder 는 v7 과 같은 파일을 COPY 한다(복제본 없음). run 스크립트가
#   bind-mount 로 호스트 최신본을 덮어쓰므로 실제 실행되는 것도 같은 파일이다.
# ※ 머리만 A/B 로 확인하려면 --no-wrists (run 스크립트의 NO_WRISTS=1)를 쓴다.
WORKDIR /app
COPY src/camera_forwarder_3cam.py /app/camera_forwarder_3cam.py
COPY config/cyclonedds.xml /etc/cyclonedds.xml

# -----------------------------------------------------------------------------
# 8. 개발 편의 (/root/.bashrc) — docker exec 로 들어가 디버깅할 때
# -----------------------------------------------------------------------------
RUN { \
        echo "export CYCLONEDDS_HOME=/opt/cyclonedds/install"; \
        echo "export CycloneDDS_DIR=/opt/cyclonedds/install/lib/cmake/CycloneDDS"; \
        echo "export CMAKE_PREFIX_PATH=/opt/cyclonedds/install:/opt/ros/foxy:\$CMAKE_PREFIX_PATH"; \
        echo "export LD_LIBRARY_PATH=/opt/cyclonedds/install/lib:/opt/ros/foxy/lib:/opt/ros/foxy/lib/aarch64-linux-gnu:\$LD_LIBRARY_PATH"; \
        echo "export PATH=/opt/cyclonedds/install/bin:\$PATH"; \
        echo "export CYCLONEDDS_URI=file:///etc/cyclonedds.xml"; \
    } >> /root/.bashrc

# -----------------------------------------------------------------------------
# 9. Runtime notes / CMD
# -----------------------------------------------------------------------------
# - USB 장치를 직접 연다. run 스크립트가 -v /dev:/dev + device-cgroup-rule 로
#   패스스루를 넘겨야 한다.
# - --network host 필요(ZMQ 5555, videohub 백엔드일 때는 DDS discovery 도).
# - 호스트 서비스(videohub_pc4 등)를 정지·재시작하지 않는다. RSUSB 는 커널
#   uvcvideo 를 우회하므로 공존한다. 다만 libusb 가 USB 인터페이스를 claim 할
#   때 videohub 피드가 잠시 끊길 수 있다.
# - CMD 는 exec form 이라 셸 없이 python3 가 PID 1 이 된다. ROS 2 setup.bash 를
#   source 할 필요가 없다 — 필요한 값은 전부 ENV 에 있다.
EXPOSE 5555

# --head-backend realsense 를 명시한다(forwarder 의 argparse 기본값은 videohub).
# videohub 폴백은 run 스크립트의 HEAD_BACKEND=videohub 로 준다.
# --head-serial 은 넣지 않는다 — 로봇마다 다르고, 미지정 시 forwarder 가
# "이름에 405가 없는 장치"를 골라 손목 D405 를 건드리지 않는다.
# 손목 좌우가 바뀌면 run 스크립트에서 --left-node/--right-node 로 고정한다.
CMD ["python3", "/app/camera_forwarder_3cam.py", \
     "--port", "5555", \
     "--head-mount", "ego_view", \
     "--head-backend", "realsense", \
     "--head-width", "640", \
     "--head-height", "480", \
     "--head-fps", "30", \
     "--wrist-width", "640", \
     "--wrist-height", "480"]
