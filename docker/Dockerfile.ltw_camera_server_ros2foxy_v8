# =============================================================================
# ltw-camera-server:1.1-foxy-3cam   (v8 = v7 + librealsense 머리 직결)
#
# v7(1.0-foxy-3cam)과 섹션 1~5가 **바이트 동일**하고, 섹션 5.5만 다르다.
# v7은 pip wheel(`pyrealsense2`)을 깔았고, v8은 **librealsense를 소스에서
# -DFORCE_RSUSB_BACKEND=true 로 빌드**한다. 첫 명령어 차이가 섹션 5.5이므로
# CycloneDDS 소스빌드(섹션 3.5, 30~60분)를 포함한 앞 레이어는 전부 캐시
# 히트하고 5.5부터만 다시 돈다.
#
# [v7 대비 실질 변경 — 2개]
#   1. 섹션 5.5: pip wheel -> librealsense 소스빌드(RSUSB 백엔드).
#      ★ 이게 v8의 전부다. 이유는 섹션 5.5 주석에 실측 근거와 함께 상세히
#        적어뒀다. 요약하면: pip wheel은 V4L2 백엔드라 L4T 순정 uvcvideo의
#        XU 컨트롤 한계(-32 EPIPE)에 걸려 **프레임이 0개**였다. RSUSB는
#        V4L2를 통째로 우회하므로 커널 패치 없이 이 문제를 넘는다.
#   2. CMD에 --head-backend realsense 명시 (forwarder의 argparse 기본값은
#      videohub이라 v7은 영향받지 않는다).
#
# [왜 파일을 나눴나 — v7을 안 건드리는 이유]
#   머리 librealsense 직결은 2026-07-21 현재 **아직 프레임 취득 성공 전**이다.
#   검증 안 된 경로가 known-good(v7 = 25Hz 채택본)을 덮어쓰면 문제 발생 시
#   돌아갈 곳이 없어진다.
#   ★ 태그가 반드시 달라야 한다(1.0 vs 1.1) — 같으면 v8 빌드가 v7 이미지를
#     덮어써서 롤백 자산이 사라진다.
#
#   ※ forwarder(camera_forwarder_3cam.py)는 v7과 **공유**한다. 복제하지 않는다.
#     `--head-backend` 기본값이 videohub라서 같은 파일로 v7 동작이 그대로
#     재현되기 때문이다. (v6가 이미지 두 벌을 따로 관리하다 실패한 전례가 있다.)
#
# 결과: 머리(ego_view) + 좌우 손목(D405, V4L2)을 하나의 ZMQ 5555 페이로드로
#       합쳐 forward. 머리는 두 경로 중 택1 —
#         --head-backend videohub  : VideoClient RPC (v7과 동일, 1080p, ~15Hz)
#         --head-backend realsense : librealsense 직결 (640x480@30 직접 요청)
#       RSUSB 백엔드는 커널 uvcvideo를 우회하므로 videohub과 공존할 여지가
#       있으나 **미검증**이다. 2026-07-21 현재는 수집 중 videohub을 정지하는
#       것을 전제로 한다(팀 승인: 수집 전 stop -> 수집 중 독점 -> 종료 전 원복).
#       workstation의 run_data_exporter.py --record-wrist-cameras 와 짝을 이룬다.
#
# Target: Unitree G1 Orin NX (PC2, eth0 192.168.123.164/24, aarch64,
#         JetPack R35.3.1 / Ubuntu 20.04 focal, Python 3.8)
#
# [빌드 전 필수 실측 — 새 로봇에서]
#   이 이미지의 버전 핀은 전부 "구 G1 Orin NX"의 실측값에 맞춰져 있다.
#   새 로봇에서 아래 3개가 다르면 그에 맞게 고쳐야 한다:
#     1) videohub CycloneDDS 버전 (섹션 3.5의 0.10.2가 여기 걸려 있음)
#          sudo ldd /proc/$(pgrep videohub_pc4)/exe | grep dds
#        ※ --head-backend realsense 만 쓴다면 이 핀은 무의미해진다(DDS 미사용).
#          손목/머리 모두 DDS를 안 거치므로 섹션 3~4.6을 통째로 걷어낼 여지가
#          있다 — 다만 videohub 폴백을 포기하는 것이므로 실측 검증 후에 하라.
#     2) JetPack/L4T 버전 (r35.3.1 = Python 3.8 전제, 섹션 4.7/5/5.5 핀의 근거)
#          cat /etc/nv_tegra_release
#     3) D405 color 노드 by-id 경로 (시리얼은 동일하나 -video-indexN 은
#        커널 열거 순서에 따라 바뀔 수 있다)
#          ls /dev/v4l/by-id/
#
# [Build] (Orin NX에서, docker/ 를 build context로 — src/, config/ 상대 경로
#          COPY 때문에 docker/ 루트로 지정해야 한다)
#   docker build -f docker/Dockerfile.ltw_camera_server_ros2foxy_v8 \
#                -t ltw-camera-server:1.1-foxy-3cam docker/
#
# [Run]
#   ./docker/run_ltw_camera_server_ros2foxy_v8.sh          # 머리=realsense(기본)
#   HEAD_BACKEND=videohub ./docker/run_..._v8.sh           # 머리=RPC(v7과 동일)
#
# [Rollback] — v7 이미지는 그대로 남아 있으므로 즉시 복귀 가능
#   docker rm -f ltw-camera-server 2>/dev/null
#   ./docker/run_ltw_camera_server_ros2foxy_v7.sh    # 1.0-foxy-3cam 그대로 사용
#   docker rmi ltw-camera-server:1.1-foxy-3cam       # v8을 지울 때만
#
# [이력]
#   0.1~0.7 의 시행착오(rclpy topic subscribe 실패 → VideoClient RPC 전환,
#   CycloneDDS wire protocol mismatch 추적)는 Dockerfile.ltw_camera_server_*
#   시리즈에 학습 자산으로 보존돼 있다. 이 파일은 그 결론만 담는다.
# =============================================================================

# l4t-jetpack r35.3.1 = JetPack 5.1.1 = Ubuntu 20.04(focal) 기반 — 호스트
# OS(Ubuntu 20.04, Foxy)와 정확히 일치. Jetson용 CUDA/L4T 런타임 레이어를
# 이미 포함하고 있어 향후 GPU 가속(예: 영상 처리)이 필요해질 때 base 교체
# 없이 확장 가능하다. 이 컨테이너 자체는 GPU를 쓰지 않는다.
FROM nvcr.io/nvidia/l4t-jetpack:r35.3.1

ENV DEBIAN_FRONTEND=noninteractive
ENV ROS_DISTRO=foxy
ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8
SHELL ["/bin/bash", "-c"]

# -----------------------------------------------------------------------------
# 1. Base tools + locale
# -----------------------------------------------------------------------------
# build-essential + cmake: 섹션 3.5의 CycloneDDS 소스빌드에 필요.
# python3-dev, libpython3-dev: 섹션 4.5에서 --no-binary cyclonedds 소스빌드 시
#   Python.h 헤더 필요.
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        curl \
        git \
        gnupg \
        libpython3-dev \
        locales \
        lsb-release \
        python3-dev \
        python3-pip \
    && locale-gen en_US.UTF-8 \
    && update-locale LANG=en_US.UTF-8 \
    && rm -rf /var/lib/apt/lists/*

# -----------------------------------------------------------------------------
# 2. ROS 2 Foxy apt source
# -----------------------------------------------------------------------------
# r35.3.1 = Ubuntu 20.04 = focal 이므로 ROS 2 공식 apt repo의 focal 라인을
# 그대로 사용한다 (별도 backport/PPA 불필요).
RUN curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
        -o /usr/share/keyrings/ros-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu $(lsb_release -cs) main" \
        > /etc/apt/sources.list.d/ros2.list

# -----------------------------------------------------------------------------
# 3. ROS 2 Foxy + rmw-cyclonedds (apt)
# -----------------------------------------------------------------------------
# 이 스택은 rclpy/rmw를 실제로는 거치지 않는다(VideoClient RPC가 Python
# cyclonedds binding으로 libddsc를 직접 호출). 그럼에도 Foxy를 유지하는 이유:
#   (1) 향후 다른 센서 통합 시 활용 여지
#   (2) rosidl-generator-dds-idl 를 Python cyclonedds가 IDL 처리에 쓸 수 있음
# 여기서 apt로 딸려오는 CycloneDDS 0.7.x(libddsc.so.0)는 그대로 두되, 섹션
# 3.6의 LD_LIBRARY_PATH override로 런타임에는 우리가 소스빌드한 0.10.2가
# 우선 로드된다 — apt 패키지를 지울 필요 없이 로드되는 .so만 바꿔치기한다.
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3-catkin-pkg \
        python3-empy \
        python3-lark \
        ros-foxy-ros-base \
        ros-foxy-rmw-cyclonedds-cpp \
        ros-foxy-rosidl-generator-dds-idl \
        python3-colcon-common-extensions \
    && rm -rf /var/lib/apt/lists/*

# -----------------------------------------------------------------------------
# 3.5. CycloneDDS 0.10.2 (source build) — 이 이미지의 핵심
# -----------------------------------------------------------------------------
# 왜 0.10.2 소스빌드인가 (v1~v2 실패의 근본 원인):
#   호스트 videohub_pc4는 CycloneDDS 0.10.2 소스빌드를 쓰는데, apt의
#   ros-foxy-cyclonedds는 0.7.0이라 DDSI-RTPS wire protocol이 mismatch였다.
#   (segfault, bad_alloc, discovery 후 data zero 등으로 발현)
#
# 구 로봇 실측:
#   sudo ldd /proc/$(pgrep videohub_pc4)/exe | grep dds
#   → libddsc.so.0 => /home/unitree/cyclonedds_ws/install/cyclonedds/lib/libddsc.so.0
#   sudo cat /proc/$(pgrep videohub_pc4)/maps | grep dds
#   → libddsc.so.0.10.2
#
# ★ 새 로봇에서 이 값을 반드시 재확인할 것. 다르면 CYCLONEDDS_VERSION과
#   섹션 4.5의 Python binding 버전을 함께 그 값으로 맞춰야 한다. 버전이
#   어긋나면 크래시 없이 조용히 discovery만 실패한다 — 진단이 어렵다.
#
# 이 버전은 두 가지 목적을 겸한다:
#   (1) 호스트 videohub_pc4와 wire protocol 매칭
#   (2) unitree_sdk2py의 setup.py가 요구하는 cyclonedds==0.10.2 Python
#       binding의 C library 백엔드 제공 (섹션 4.5)
ARG CYCLONEDDS_VERSION=0.10.2

WORKDIR /opt
RUN git clone --depth 1 --branch ${CYCLONEDDS_VERSION} \
    https://github.com/eclipse-cyclonedds/cyclonedds.git

WORKDIR /opt/cyclonedds/build
RUN cmake .. \
        -DBUILD_EXAMPLES=OFF \
        -DBUILD_IDLC=ON \
        -DCMAKE_INSTALL_PREFIX=/opt/cyclonedds/install \
    && cmake --build . --target install \
    && rm -rf /opt/cyclonedds/build

# 참고: ENABLE_SHM을 명시하지 않고 CycloneDDS 기본값을 그대로 쓴다(구 로봇에서
# 이 구성으로 검증됨). SHM 관련 문제가 생기면 -DENABLE_SHM=OFF 검토.

# -----------------------------------------------------------------------------
# 3.6. CycloneDDS ENV (LD_LIBRARY_PATH override)
# -----------------------------------------------------------------------------
# LD_LIBRARY_PATH의 순서가 결정적이다:
#   /opt/cyclonedds/install/lib   ← 우리 0.10.2, 먼저 있어야 함
#   /opt/ros/foxy/lib             ← apt 0.7.0, 뒤에 있어야 함
# 로더가 이 순서로 검색해 우리 0.10.2를 먼저 찾는다. apt 것은 무시된다.
ENV CYCLONEDDS_HOME=/opt/cyclonedds/install
ENV CycloneDDS_DIR=/opt/cyclonedds/install/lib/cmake/CycloneDDS
ENV CMAKE_PREFIX_PATH=/opt/cyclonedds/install:/opt/ros/foxy
ENV LD_LIBRARY_PATH=/opt/cyclonedds/install/lib:/opt/ros/foxy/lib:/opt/ros/foxy/lib/aarch64-linux-gnu
ENV PATH=/opt/cyclonedds/install/bin:${PATH}

# -----------------------------------------------------------------------------
# 4. Python packaging preparation
# -----------------------------------------------------------------------------
# setuptools 59.6.0은 kist-drl-g1-onboard 팀이 검증한 안정 버전. 최신
# setuptools는 ament_python 등과 충돌 가능하므로 고정한다.
RUN python3 -m pip install --upgrade pip wheel \
    && python3 -m pip install --force-reinstall "setuptools==59.6.0"

# -----------------------------------------------------------------------------
# 4.5. Python CycloneDDS binding (source build, 0.10.2)
# -----------------------------------------------------------------------------
# unitree_sdk2_python의 setup.py가 정확히 cyclonedds==0.10.2를 요구한다.
# --no-binary cyclonedds: pre-built wheel은 자체 CycloneDDS를 번들해서 섹션
#   3.5의 소스빌드본과 충돌할 위험이 있으므로 소스에서 빌드한다. 빌드 시
#   CYCLONEDDS_HOME(섹션 3.6)을 참조해 우리 C library로 링크된다.
RUN python3 -m pip install --no-cache-dir \
    --no-binary cyclonedds \
    "cyclonedds==0.10.2"

# -----------------------------------------------------------------------------
# 4.6. unitree_sdk2_python — 머리 카메라 접근의 핵심
# -----------------------------------------------------------------------------
# Unitree 공식 Python SDK. VideoClient, ChannelFactoryInitialize 등 제공.
# /api/videohub/request 로 RPC를 보내면 완전한 JPEG 응답이 온다. (Go2 SDK지만
# G1도 동일한 /api/videohub/* endpoint를 노출해 그대로 동작한다.)
#
# --no-deps: 이미 소스빌드한 cyclonedds를 pip이 다른 버전으로 교체하지
#   못하도록 막는다.
# 커밋 SHA pin: --no-deps라 pip이 setup.py의 요구사항을 검증하지 않으므로,
#   upstream이 cyclonedds==0.10.2 요구를 바꾸면 버전 매칭이 조용히 깨질 수
#   있다. clone 시점을 SHA로 못 박아 재현성을 확보한다.
ARG UNITREE_SDK2PY_COMMIT=37116c521f1588482e238d8450e471ba78ab9863

WORKDIR /opt
RUN git clone https://github.com/unitreerobotics/unitree_sdk2_python.git \
    && cd unitree_sdk2_python \
    && git checkout ${UNITREE_SDK2PY_COMMIT} \
    && python3 -m pip install --no-deps .

# -----------------------------------------------------------------------------
# 4.7. numpy, opencv (unitree_sdk2py 요구사항 + 손목 V4L2 캡처)
# -----------------------------------------------------------------------------
# --no-deps로 unitree_sdk2py를 설치했으므로 여기서 별도 install.
# opencv는 단순 의존성이 아니라 손목 캡처의 주역이다 — camera_forwarder_3cam이
# cv2.VideoCapture(node, CAP_V4L2)로 D405 color 노드를 직접 읽는다(섹션 5.5).
#
# 버전 pin 이유: aarch64 + Python 3.8 조합에서 최신 opencv/numpy는 prebuilt
# wheel이 없어 소스빌드로 떨어지거나 실패한다. 아래 두 버전은 이 조합에서
# prebuilt wheel(manylinux_2_17_aarch64, cp38)이 존재하는 마지막 stable 버전.
# ★ 새 로봇의 Python이 3.8이 아니면 이 핀은 전부 무효다.
RUN python3 -m pip install --no-cache-dir \
    "numpy==1.24.4" \
    "opencv-python-headless==4.8.1.78"

# -----------------------------------------------------------------------------
# 5. Python 런타임 의존성 (ZMQ 발행)
# -----------------------------------------------------------------------------
# pyzmq==25.1.2 / msgpack==1.0.5: 마찬가지로 aarch64 + Python 3.8 prebuilt
# wheel이 존재하는 버전. 더 최신은 소스빌드로 떨어져 r35.3.1에서 실패한다.
RUN python3 -m pip install --no-cache-dir \
        "pyzmq==25.1.2" \
        "msgpack==1.0.5"

# -----------------------------------------------------------------------------
# 5.5. librealsense 소스빌드 (RSUSB 백엔드) — 머리 D435i 직결의 핵심
# -----------------------------------------------------------------------------
# ★★ 왜 pip wheel이 아니라 소스빌드인가 — 2026-07-21 실측으로 확정 ★★
#
#   처음엔 `pip install pyrealsense2` (2.55.1.6486) 를 썼다. 결과:
#     [1] 장치 3대 열거 OK        (udev/권한/USB 패스스루 전부 정상)
#     [2] 640x480@30 bgr8 프로파일 노출 OK
#     [3] pipeline.start()        OK  (videohub 정지 후. 정지 전엔 EBUSY)
#     [4] wait_for_frames         ★ 0프레임 "Frame didn't arrive within 2000"
#   그리고 커널이 이렇게 찍었다:
#     uvcvideo: Failed to query (GET_CUR) UVC control 1 on unit 3: -32 (exp. 1024)
#
#   -32 = EPIPE = USB 컨트롤 엔드포인트 STALL. unit 3 = UVC의 XU(extension
#   unit). librealsense는 XU 컨트롤로 센서를 설정하는데, **순정 uvcvideo는 이
#   확장 컨트롤을 통과시키지 못한다.** 그래서 표준 UVC인 S_FMT까지는 되고
#   스트리밍만 안 된다. librealsense 이슈 #5302 와 동일 증상이다.
#
#   USB를 논리적으로 replug(authorized 0->1)해도 결과가 같았다 — 즉 장치가
#   wedge된 게 아니라 커널 드라이버의 구조적 한계다. 반면 호스트
#   videohub_pc4와 손목의 cv2.VideoCapture는 잘 동작하는데, 그쪽은 평범한
#   V4L2만 쓰고 XU를 건드리지 않기 때문이다.
#
#   공식 Jetson 설치 문서가 제시하는 해법은 둘뿐이다:
#     (a) 커널 uvcvideo 패치 (scripts/patch-realsense-ubuntu-L4T.sh)
#         -> 공유 로봇의 커널 모듈을 교체하고 재부팅해야 한다. 다른 사용자
#            전원에게 영향이 가므로 채택하지 않는다.
#     (b) -DFORCE_RSUSB_BACKEND=true 로 소스빌드
#         -> V4L2/uvcvideo를 통째로 우회하고 libusb로 직접 USB를 다룬다.
#            커널을 안 건드리고 **컨테이너 안에서 완결**된다. 이걸 쓴다.
#
#   ※ RSUSB의 알려진 제약: multi-cam 시나리오에 최적화돼 있지 않다. 우리는
#     머리 1대만 librealsense로 열고 손목 D405 2대는 그대로 커널 V4L2
#     (cv2.VideoCapture)로 읽으므로 이 제약에 해당하지 않는다.
#
#   ※ 빌드 시간은 pip wheel보다 훨씬 길다(Orin NX에서 대략 20~40분). 대신
#     섹션 1~5는 v7과 바이트 동일하므로 CycloneDDS 소스빌드(30~60분)를 포함한
#     앞 레이어는 전부 캐시 히트한다.
#
# 버전: 직전까지 쓰던 pip wheel(2.55.1.6486)과 같은 릴리스 계열이라 API 차이가
#   없다. 올리고 싶으면 이 ARG만 바꾼다.
ARG LIBREALSENSE_VERSION=v2.55.1

# 빌드 의존성. libusb-1.0-0-dev 가 RSUSB 백엔드의 핵심이다(런타임 libusb-1.0-0
# 도 여기 포함된다). libudev-dev 는 장치 열거에 쓰인다.
RUN apt-get update && apt-get install -y --no-install-recommends \
        libssl-dev \
        libusb-1.0-0-dev \
        libudev-dev \
        pkg-config \
    && rm -rf /var/lib/apt/lists/*

# pip wheel이 남아 있으면 소스빌드본을 가리므로 먼저 제거한다(없으면 무시).
RUN python3 -m pip uninstall -y pyrealsense2 2>/dev/null || true

WORKDIR /opt
RUN git clone --depth 1 --branch ${LIBREALSENSE_VERSION} \
    https://github.com/IntelRealSense/librealsense.git

# librealsense 빌드는 3개 RUN으로 나눈다 — 실패 지점을 좁히고 **증거를 남기기**
# 위해서다. 한 RUN에 cmake+make+install+rm 을 다 넣었다가 `rm -rf build` 로
# CMakeCache.txt까지 지워버려서, "왜 본체 모듈이 안 나왔는가"를 사후에 확인할
# 방법이 없었다(2026-07-21). 같은 실수를 반복하지 않는다.
#
# ★ 빌드 트리(/opt/librealsense/build)를 **지우지 않는다.** 이미지가 1~2GB
#   커지지만, 산출물과 CMakeCache가 남아 있어야 문제가 생겼을 때 컨테이너에
#   들어가 바로 확인할 수 있다. 파이프라인이 안정되면 그때 지운다.
WORKDIR /opt/librealsense/build
RUN set -eo pipefail \
    && cmake .. \
        -DCMAKE_BUILD_TYPE=Release \
        -DFORCE_RSUSB_BACKEND=true \
        -DBUILD_PYTHON_BINDINGS=true \
        -DPYTHON_EXECUTABLE=/usr/bin/python3 \
        -DPython_EXECUTABLE=/usr/bin/python3 \
        -DPython3_EXECUTABLE=/usr/bin/python3 \
        -DPython_ROOT_DIR=/usr \
        -DPython3_ROOT_DIR=/usr \
        -DBUILD_EXAMPLES=false \
        -DBUILD_GRAPHICAL_EXAMPLES=false \
        -DBUILD_WITH_CUDA=false \
        -DCMAKE_INSTALL_PREFIX=/usr/local \
        2>&1 | tee /opt/librealsense/cmake_configure.log \
    && echo "=== [v8] cmake가 고른 Python / 바인딩 설정 ===" \
    && grep -iE "python|pybind|binding" /opt/librealsense/cmake_configure.log || true

# 컴파일. Orin NX에서 20~40분.
# 메모리 부족(c++: fatal error: Killed)이 나면 -j"$(nproc)" 를 -j4 로 낮출 것.
RUN make -j"$(nproc)"

# ★ 이 단계가 이번 빌드의 핵심 관측이다 — install 전에 **빌드 트리에 무엇이
#   만들어졌는지**를 그대로 찍는다. 2026-07-21 실측에서는 install 결과가
#   pyrsutils 하나뿐이었고 본체(pyrealsense2.cpython-*.so)가 어디에도 없었는데,
#   빌드 트리를 지워버려서 "애초에 안 만들어진 것"인지 "만들어졌는데 install이
#   빠진 것"인지 구분할 수 없었다. 여기서 그 답이 나온다.
#   (공식 문서: BUILD_PYTHON_BINDINGS 가 ON이면 pyrsutils 가 추가로 빌드된다
#    -> pyrsutils 가 나왔다는 것 자체가 바인딩이 켜져 있었다는 증거다. 즉
#    플래그 형식(:bool=true) 문제는 아니다.)
RUN echo "=== [v8] 빌드 트리에 생성된 Python 모듈 ===" \
    && (find /opt/librealsense/build \( -name "py*.so*" -o -name "*.pyd" \) \
            -printf "%10s  %p\n" | sort -k2 || true) \
    && echo "=== [v8] wrappers/python 빌드 산출물 트리 ===" \
    && (ls -laR /opt/librealsense/build/wrappers/python 2>/dev/null | head -60 || true)

RUN make install && ldconfig

# -----------------------------------------------------------------------------
# 5.6. pyrealsense2 배치 + 검증
# -----------------------------------------------------------------------------
# ★ 2026-07-21 실측으로 드러난 함정 두 가지를 여기서 정리한다.
#
# (1) pip 잔재가 만드는 "가짜 성공"
#     섹션 5.5의 `pip uninstall -y pyrealsense2` 는 파일만 지우고 **빈
#     디렉터리 /usr/lib/python3/dist-packages/pyrealsense2/ 를 남긴다.**
#     그 상태에서 `import pyrealsense2` 는 **성공한다** — 파이썬이 그 빈
#     디렉터리를 namespace package 로 잡기 때문이다. 증상:
#         rs.__file__  -> None
#         dir(rs)      -> ['__doc__','__file__','__loader__','__name__',
#                          '__package__','__path__','__spec__']
#     import 이 되니 문제가 없어 보이지만 pipeline 같은 심볼이 하나도 없다.
#     그래서 아래 검증은 import 성공 여부가 아니라 **rs.__file__ 이 실제
#     .so 를 가리키는지**로 판정한다.
#
# (2) 설치 위치는 추측하면 안 된다
#     librealsense 는 python 모듈을 sysconfig 가 알려주는 경로에 깐다. 이
#     이미지에서는 /usr/lib/python3/dist-packages/pyrealsense2/ 였다
#     (pyrsutils 가 거기 깔린 것이 증거). 그러나 버전/플랫폼마다 다르므로
#     경로를 박지 않고 **find 로 찾아서** 배치한다. 빌드 트리도 함께 뒤진다
#     — install 규칙이 빠뜨렸을 경우 거기에는 있을 수 있기 때문이다.
#
# (3) 파일명이 `.so` 로 **끝나야** 한다 — 이것 때문에 한 번 더 실패했다
#     librealsense 는 버전 접미사가 붙은 실체 파일과 심볼릭 링크를 함께 만든다:
#         pyrealsense2.cpython-38-aarch64-linux-gnu.so         -> ...so.2.55
#         pyrealsense2.cpython-38-aarch64-linux-gnu.so.2.55    -> ...so.2.55.1
#         pyrealsense2.cpython-38-aarch64-linux-gnu.so.2.55.1  (실체, 1.9MB)
#     `find -type f` 로 찾으면 심볼릭 링크가 걸러져 **실체 파일**만 잡히는데,
#     그 이름은 `.so.2.55.1` 로 끝난다. 파이썬 확장모듈 로더는 `.so` 로 끝나는
#     파일만 모듈로 인식하므로, 복사해봐야 import 대상이 아니다(그래서 또
#     빈 namespace 디렉터리가 잡혔다). 복사할 때 버전 접미사를 떼어낸다.
#
# ★ 참고: 이 이미지에서 `make install` 은 본체 모듈을 설치하지 않는다.
#   pyrsutils 와 cmake 파일만 /usr/lib/python3/dist-packages/pyrealsense2/ 에
#   깔고 본체는 빌드 트리(build/Release/)에만 남긴다 — librealsense 2.55 의
#   install 규칙 문제로 보인다. 그래서 아래에서 빌드 트리를 직접 뒤진다.
#   (2026-07-21 실측: 본체는 정상 빌드됨 = 1.88MB, cmake 도 python3.8 을
#    Interpreter/Development 모두 제대로 찾음 -> 순수 install 누락)
#
# 배치 전략: 본체 .so 를 PYTHONPATH 최상위 디렉터리에 **모듈 파일 그대로**
#   둔다(패키지 디렉터리 안에 넣지 않는다). 패키지 디렉터리 안에 넣으면 위
#   (1)의 namespace package 가 먼저 잡혀서 또 가려지기 때문이다. PYTHONPATH가
#   시스템 dist-packages 보다 앞서므로 우리 모듈이 이긴다.
ENV PYTHONPATH=/usr/local/lib/python3.8/dist-packages
ENV LD_LIBRARY_PATH=/usr/local/lib:/opt/cyclonedds/install/lib:/opt/ros/foxy/lib:/opt/ros/foxy/lib/aarch64-linux-gnu

RUN set -x \
    && echo "=== [v8] 설치된 librealsense python 산출물 ===" \
    && (find /usr/local /usr/lib \( -name "*pyrealsense2*" -o -name "*pyrsutils*" \
            -o -name "*pybackend2*" \) 2>/dev/null || true) \
    && mkdir -p /usr/local/lib/python3.8/dist-packages \
    && echo "=== [v8] 본체 모듈 탐색 (설치 위치 + 빌드 트리) ===" \
    && RS_SO="$(find /usr/local/lib /usr/lib /opt/librealsense/build \
                     -name 'pyrealsense2*.so*' -type f 2>/dev/null | head -1)" \
    && echo "찾은 본체 모듈: '${RS_SO:-<없음>}'" \
    && if [ -z "$RS_SO" ]; then \
           echo "!!! [v8] pyrealsense2 본체 .so 를 찾지 못했다."; \
           echo "!!! 위 '빌드 트리에 생성된 Python 모듈' 출력을 확인할 것."; \
           echo "!!! pyrsutils 만 있고 본체가 없다면 타깃이 all 에 포함되지"; \
           echo "!!! 않았다는 뜻 -> make pyrealsense2 를 명시 호출해야 한다."; \
           exit 1; \
       fi \
    && RS_NAME="$(basename "$RS_SO" | sed 's/\.so\..*$/.so/')" \
    && echo "설치 파일명: $RS_NAME  (버전 접미사 제거)" \
    && cp -v "$RS_SO" "/usr/local/lib/python3.8/dist-packages/$RS_NAME" \
    && (RSU_SO="$(find /usr/local/lib /usr/lib /opt/librealsense/build \
                       -name 'pyrsutils*.so*' -type f 2>/dev/null | head -1)"; \
        if [ -n "$RSU_SO" ]; then \
            RSU_NAME="$(basename "$RSU_SO" | sed 's/\.so\..*$/.so/')"; \
            cp -v "$RSU_SO" "/usr/local/lib/python3.8/dist-packages/$RSU_NAME"; \
        fi) \
    && echo "=== [v8] dist-packages 최종 내용 ===" \
    && ls -la /usr/local/lib/python3.8/dist-packages/ \
    && echo "=== [v8] import 검증 (namespace package 가 아닌 진짜 모듈인지) ===" \
    && python3 -c "\
import pyrealsense2 as rs; \
print('[v8] rs.__file__ =', rs.__file__); \
assert rs.__file__, 'namespace package를 집었다 — 진짜 .so가 로드되지 않았다'; \
assert hasattr(rs, 'pipeline'), 'pipeline 심볼 없음'; \
print('[v8] pyrealsense2 (source build) OK, 심볼 수 =', len(dir(rs)))" \
    && echo "=== [v8] RSUSB 백엔드 확인 ===" \
    && ldd /usr/local/lib/librealsense2.so | grep -q libusb \
    && echo "[v8] librealsense2.so -> libusb 링크 확인 = RSUSB 백엔드 OK"

# -----------------------------------------------------------------------------
# 6. Runtime env
# -----------------------------------------------------------------------------
# RMW_IMPLEMENTATION은 설정하지 않는다 — VideoClient는 rclpy/rmw 레이어를
#   거치지 않고 Python cyclonedds binding이 libddsc를 직접 호출하므로 rmw
#   구현 선택 자체가 무의미하다.
# ROS_DOMAIN_ID: 호스트 videohub_pc4와 같은 domain(0)이어야
#   /api/videohub/request, /response RPC discovery가 된다.
# CYCLONEDDS_URI: Python cyclonedds binding이 이 config를 읽어 eth0을 쓴다.
ENV ROS_DOMAIN_ID=0
ENV CYCLONEDDS_URI=file:///etc/cyclonedds.xml

# -----------------------------------------------------------------------------
# 7. App
# -----------------------------------------------------------------------------
# camera_forwarder.py(머리 전용, v5 CMD가 쓰던 것)도 함께 넣어둔다 — 손목
# 문제를 배제하고 머리만 A/B로 확인할 때 이미지 교체 없이 CMD만 바꾸면 된다.
# ※ forwarder는 v7과 같은 파일을 COPY 한다(복제본 없음). run 스크립트가
#   bind-mount로 호스트 최신본을 덮어쓰므로 실제 실행되는 것도 같은 파일이다.
WORKDIR /app
COPY src/camera_forwarder_3cam.py /app/camera_forwarder_3cam.py
COPY src/camera_forwarder.py /app/camera_forwarder.py
COPY config/cyclonedds.xml /etc/cyclonedds.xml

# -----------------------------------------------------------------------------
# 8. 개발 편의 (/root/.bashrc) — docker exec로 들어가 디버깅할 때
# -----------------------------------------------------------------------------
# ENV로 이미 이미지 전체에 박혀 있지만, 여기 다시 적는 이유는 이 파일 하나만
# 보고도 exec 진입 시 어떤 값이 유효한지 바로 확인할 수 있게 하기 위함이다.
RUN { \
        echo "export CYCLONEDDS_HOME=/opt/cyclonedds/install"; \
        echo "export CycloneDDS_DIR=/opt/cyclonedds/install/lib/cmake/CycloneDDS"; \
        echo "export CMAKE_PREFIX_PATH=/opt/cyclonedds/install:/opt/ros/foxy:\$CMAKE_PREFIX_PATH"; \
        echo "export LD_LIBRARY_PATH=/opt/cyclonedds/install/lib:/opt/ros/foxy/lib:/opt/ros/foxy/lib/aarch64-linux-gnu:\$LD_LIBRARY_PATH"; \
        echo "export PATH=/opt/cyclonedds/install/bin:\$PATH"; \
        echo "export CYCLONEDDS_URI=file:///etc/cyclonedds.xml"; \
    } >> /root/.bashrc

# -----------------------------------------------------------------------------
# 9. Runtime notes / CMD
# -----------------------------------------------------------------------------
# - 이 컨테이너는 D405 USB 장치를 직접 연다. run 스크립트에서 USB
#   패스스루(-v /dev:/dev + device-cgroup-rule)를 반드시 넘겨야 한다.
#   (전용 run_ltw_camera_server_ros2foxy_v8.sh 참조)
# - --network host 필요: ZMQ 5555 노출. (--head-backend videohub 일 때는
#   VideoClient CycloneDDS discovery에도 필요하다. realsense 경로는 DDS를
#   쓰지 않지만 ZMQ 때문에 어차피 필요하다.)
# - 이 컨테이너는 videohub_pc4/호스트 서비스를 절대 정지·재시작하지 않는다.
#   --head-backend realsense 는 RSUSB(libusb)가 커널 uvcvideo를 우회하므로
#   videohub을 정지시키지 않고 공존한다. 다만 libusb가 USB 인터페이스를
#   claim 할 때 videohub 피드가 잠시 끊길 수 있다 — 2026-07-21 박사님이
#   "문제 없다"고 확인해 준 사항이다. 복구가 필요하면 호스트에서
#   `sudo systemctl restart master_service`.
# - CMD를 JSON 배열(exec form)로 지정해 셸 없이 python3가 PID 1이 된다.
#   ROS 2 setup.bash를 source할 필요도 없다 — 필요한 값은 전부 ENV에 있다.
EXPOSE 5555

# 손목 좌우가 바뀌면 --left-node/--right-node로 고정할 것(run 스크립트가
# 환경변수로 넘긴다). 미지정 시 by-id 시리얼 정렬 자동배정 + 매핑 로그 출력.
# NOTE: v6 CMD에 있던 `--wrist-fps 30`은 제거했다 — argparse에 없는 인자다
#       (run 스크립트가 CMD를 항상 덮어써서 드러나지 않았을 뿐, 인자 없이
#       docker run 하면 v6는 unrecognized arguments로 즉사한다).
# v8의 CMD는 --head-backend realsense 를 명시한다 — 이 이미지의 존재 이유가
# 그것이기 때문이다(forwarder의 argparse 기본값은 videohub이라 v7이 영향받지
# 않는다). videohub 폴백은 run 스크립트에서 HEAD_BACKEND=videohub 로 준다.
# --head-serial 은 CMD에 넣지 않는다 — 로봇마다 다르고, 미지정 시 forwarder가
# "이름에 405가 없는 장치"를 자동 선택하므로 손목 D405를 건드리지 않는다.
CMD ["python3", "/app/camera_forwarder_3cam.py", \
     "--port", "5555", \
     "--head-mount", "ego_view", \
     "--head-backend", "realsense", \
     "--head-width", "640", \
     "--head-height", "480", \
     "--head-fps", "30", \
     "--wrist-width", "640", \
     "--wrist-height", "480"]
